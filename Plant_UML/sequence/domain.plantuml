@startuml
title Domain Models (User, Car)

class User {
  + id: int
  + first_name: str
  + role: str <<admin|customer>>
  + is_admin(): bool
}

class Car {
  + id: int
  + make: str
  + model: str
  + color: str
  + year: int
  + mileage: int
  + daily_rate: float
  + available_now: int
  + min_days: int
  + max_days: int
}
@enduml
